# llama.cpp (llama-server) on this machine or your network.
# Paste these lines into .env in place of the model block.
#
# Start the server with an instruct model, for example:
#   llama-server -m your-model.gguf --host 0.0.0.0 --port 8080 --jinja
# --host 0.0.0.0 lets the container reach it; without it llama-server only
# listens on 127.0.0.1 of the host.

LLM_PROVIDER=openai
# host.docker.internal = the machine Docker runs on. For another machine use
# its address, e.g. http://192.168.1.20:8080/v1
LLM_BASE_URL=http://host.docker.internal:8080/v1
# llama-server answers with whatever model it loaded; the name is still required.
LLM_MODEL=qwen3-30b-a3b
# llama-server enforces the JSON schema with a grammar, so leave this on.
LLM_JSON_SCHEMA=true
# Small machines can take a while per merchant; this is per request.
LLM_TIMEOUT_SECONDS=300
# No key needed unless you started llama-server with --api-key.
# LLM_API_KEY=your-api-key

# Optional merchant lookup (see searxng.env):
# SEARXNG_URL=https://searx.example.com
# SEARCH_RESULTS=3

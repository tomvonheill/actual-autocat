# OpenRouter: many hosted models behind one OpenAI-compatible API.
# Paste these lines into .env in place of the model block.
#
# Privacy: each merchant's prompt (your category names, guidance.md, the
# merchant name, up to 3 raw bank lines, a typical amount and any search
# snippets) goes to OpenRouter and the model provider it routes to.

LLM_PROVIDER=openai
LLM_BASE_URL=https://openrouter.ai/api/v1
# Paste your key here yourself; never share it in a chat.
LLM_API_KEY=your-openrouter-api-key
# Any model slug from openrouter.ai/models.
LLM_MODEL=openai/gpt-4.1-mini
# Not every model on OpenRouter supports JSON schemas. If requests fail with
# HTTP 400, set this to false (the reply is then parsed leniently).
LLM_JSON_SCHEMA=true
LLM_TIMEOUT_SECONDS=60

# Optional merchant lookup (see searxng.env):
# SEARXNG_URL=https://searx.example.com
# SEARCH_RESULTS=3

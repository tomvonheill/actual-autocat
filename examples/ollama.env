# Ollama, through its OpenAI-compatible endpoint (/v1).
# Paste these lines into .env in place of the model block.
#
# Pull a model first, for example:  ollama pull qwen3:30b
# Ollama listens on 127.0.0.1 by default; set OLLAMA_HOST=0.0.0.0 so the
# container can reach it, or run Ollama in the same compose project and use
# http://ollama:11434/v1.

LLM_PROVIDER=openai
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Exactly as `ollama list` shows it.
LLM_MODEL=qwen3:30b
# Recent Ollama versions honor JSON schemas. If yours returns an error or
# ignores it, set this to false (the reply is then parsed leniently).
LLM_JSON_SCHEMA=true
LLM_TIMEOUT_SECONDS=300
# No API key needed.

# Optional merchant lookup (see searxng.env):
# SEARXNG_URL=https://searx.example.com
# SEARCH_RESULTS=3

# LM Studio's local server (Developer tab -> Start server).
# Paste these lines into .env in place of the model block.
#
# Turn on "Serve on Local Network" in the server settings so the container can
# reach it, and load the model you name below.

LLM_PROVIDER=openai
LLM_BASE_URL=http://host.docker.internal:1234/v1
# The model identifier LM Studio shows for the loaded model.
LLM_MODEL=qwen/qwen3-30b-a3b
# LM Studio supports JSON schema structured output.
LLM_JSON_SCHEMA=true
LLM_TIMEOUT_SECONDS=300
# No API key needed unless you turned on authentication.
# LLM_API_KEY=your-api-key

# Optional merchant lookup (see searxng.env):
# SEARXNG_URL=https://searx.example.com
# SEARCH_RESULTS=3

# Claude, through Anthropic's API (official SDK, structured output, so the
# reply is always valid JSON).
# Paste these lines into .env in place of the model block.
#
# Privacy: each merchant's prompt (your category names, guidance.md, the
# merchant name, up to 3 raw bank lines, a typical amount and any search
# snippets) is sent to Anthropic. See "Privacy" in the README.

LLM_PROVIDER=anthropic
# Leave LLM_BASE_URL out entirely for anthropic.
# Paste your key here yourself; never share it in a chat.
LLM_API_KEY=your-anthropic-api-key
# Cheaper Claude models work too: change the name, e.g. to a Sonnet or Haiku model.
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=60

# Optional merchant lookup (see searxng.env):
# SEARXNG_URL=https://searx.example.com
# SEARCH_RESULTS=3

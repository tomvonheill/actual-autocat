# OpenAI's API.
# Paste these lines into .env in place of the model block.
#
# Privacy: with a hosted model, each merchant's prompt (your category names,
# guidance.md, the merchant name, up to 3 raw bank lines, a typical amount and
# any search snippets) is sent to OpenAI. See "Privacy" in the README.

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
# Paste your key here yourself; never share it in a chat.
LLM_API_KEY=your-openai-api-key
# A small, inexpensive chat model is plenty for this. Requests are sent with
# temperature 0, so pick a model that accepts it (reasoning models that only
# allow the default temperature return HTTP 400).
LLM_MODEL=gpt-4.1-mini
LLM_JSON_SCHEMA=true
LLM_TIMEOUT_SECONDS=60

# Optional merchant lookup (see searxng.env):
# SEARXNG_URL=https://searx.example.com
# SEARCH_RESULTS=3

# Merchant lookup through your own SearXNG instance (optional, works with any
# model). Add these lines to .env.
#
# Before each model request, the cleaned-up bank line (e.g. "BLUE BOTTLE
# OAKLAND" from "SQ *BLUE BOTTLE OAKLAND CA") is searched, and the first few
# result snippets go into the prompt. The model never calls tools itself.
# Results are cached in /data/search-cache.json for 30 days.
#
# SearXNG must allow JSON output, which is off by default. In its settings.yml:
#
#   search:
#     formats:
#       - html
#       - json
#
# then restart SearXNG. Without it SearXNG answers with 403 or an HTML page and
# `docker compose run --rm autocat check` tells you so.
#
# Privacy: SearXNG forwards the query (merchant name and city from your bank
# line) to the search engines it is configured to use. Nothing else from your
# budget is sent.

# Base URL, as reachable from inside the container. Examples:
#   http://searxng:8080 (SearXNG in the same compose project)
#   http://host.docker.internal:8888 (on this machine)
SEARXNG_URL=https://searx.example.com
# Snippets per merchant. 3 is a good balance for small models.
SEARCH_RESULTS=3

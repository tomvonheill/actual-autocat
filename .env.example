# actual-autocat configuration
#
# Copy this file to .env and fill it in:   cp .env.example .env
# Lines starting with "#" are comments. A commented-out setting uses the default
# shown next to it; remove the "#" to change it. Don't put comments after a value
# on the same line. Ready-made model and search blocks are in examples/*.env.
#
# Docker Compose expands "$" in .env values: wrap a value containing "$" (often
# a password) in single quotes, e.g. ACTUAL_PASSWORD='pa$$word'.
#
# Never commit .env: it holds passwords and API keys (it is in .gitignore).

# ---------------------------------------------------------------------------
# Actual Budget
# ---------------------------------------------------------------------------

# URL of your Actual server as seen from INSIDE the container. "localhost" there
# is the container itself: use the server's LAN address, a Docker service name
# on the same network (e.g. http://actual_server:5006), or host.docker.internal
# for a server on the same machine. Required.
ACTUAL_SERVER_URL=http://host.docker.internal:5006

# The password you log in to Actual with. Required.
ACTUAL_PASSWORD=your-password

# The budget's Sync ID: in Actual, Settings -> Show advanced settings -> Sync ID. Required.
ACTUAL_BUDGET_ID=your-sync-id

# Only for budgets with end-to-end encryption turned on. Default: empty.
# ACTUAL_ENCRYPTION_PASSWORD=your-encryption-password

# ---------------------------------------------------------------------------
# Model (see examples/*.env for llama.cpp, Ollama, LM Studio, OpenAI,
# OpenRouter and Claude)
# ---------------------------------------------------------------------------

# "openai" for any OpenAI-compatible /chat/completions server (llama.cpp,
# Ollama, LM Studio, vLLM, OpenAI, OpenRouter), or "anthropic" for Claude.
# Default: openai.
LLM_PROVIDER=openai

# Base URL of the OpenAI-compatible server, ending in /v1. Required when
# LLM_PROVIDER=openai; must be left out when LLM_PROVIDER=anthropic.
# Examples: http://host.docker.internal:8080/v1 (llama.cpp),
# http://ollama:11434/v1 (Ollama in the same compose project),
# https://api.openai.com/v1
LLM_BASE_URL=http://host.docker.internal:8080/v1

# API key. Required for hosted providers (OpenAI, OpenRouter, Anthropic);
# leave out for a local server that doesn't need one. Default: empty.
# LLM_API_KEY=your-api-key

# Model name exactly as your server expects it. Required.
# Examples: qwen3-30b-a3b (llama.cpp), qwen3:30b (Ollama), gpt-4.1-mini (OpenAI),
# claude-opus-5-5 (Anthropic)
LLM_MODEL=your-model-name

# Send a JSON schema (response_format) with OpenAI-compatible requests so the
# reply is always a valid category. Set to false if your server rejects it.
# Ignored for anthropic. Default: true.
# LLM_JSON_SCHEMA=true

# Timeout for one model request, in seconds. Default: 300 (small machines are slow).
# LLM_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Merchant lookup with SearXNG (optional, see examples/searxng.env)
# ---------------------------------------------------------------------------

# Base URL of your SearXNG instance. Empty turns search off. JSON output must
# be enabled in SearXNG's settings.yml:  search: formats: [html, json]
# Default: empty. Example: https://searx.example.com
# SEARXNG_URL=https://searx.example.com

# How many search results per merchant go into the prompt. Default: 3.
# SEARCH_RESULTS=3

# ---------------------------------------------------------------------------
# Schedule and safety
# ---------------------------------------------------------------------------

# When to run, as a cron expression (minute hour day month weekday).
# Default: 0 2 * * * (every night at 02:00). An empty value (SCHEDULE=)
# runs once and exits: only for "docker compose run" or your own host cron.
# With "docker compose up -d" (restart: unless-stopped) it would restart and
# run again and again.
# SCHEDULE=0 2 * * *

# Time zone for SCHEDULE. Default: UTC. Example: America/New_York
# TZ=UTC

# Also run once as soon as the container starts. Default: false.
# RUN_ON_START=false

# true = report only: nothing in Actual changes and the summary says what
# WOULD happen. Start with true; set false when you like what you see.
# Default: true.
DRY_RUN=true

# Run bank sync in Actual before categorizing (never in a dry run, since it
# imports transactions). Default: true.
# SYNC_BEFORE_RUN=true

# Regular expression of payee names to leave alone, matched case-insensitively
# anywhere in the name. Default: empty (skip nothing).
# Example: skip card payments and transfers:
# SKIP_PAYEES=^(payment|transfer|autopay)|credit card

# Ask the model about at most this many merchants per run (most transactions
# first); the rest wait for the next run. Handy for a first run on a slow
# model. Default: 0 (no limit).
# MAX_PAYEES_PER_RUN=0

# Category NAME for merchants the model says have no single category
# (marketplaces, general stores, payment apps, ATMs); a rule to it is created.
# Empty: those merchants are left uncategorized, listed as "varies, left
# alone", and not asked about again. Default: empty. Example: Miscellaneous
# MIXED_PAYEE_CATEGORY=Miscellaneous

# Text appended to the notes of every transaction this tool categorizes, so
# you can search for them in Actual. Set it to nothing (NOTES_TAG=) to turn it
# off. Default: #autocat
# NOTES_TAG=#autocat

# ---------------------------------------------------------------------------
# Telegram summary (optional: set both to get a message after each run that
# did something)
# ---------------------------------------------------------------------------

# Bot token from @BotFather. Default: empty.
# TELEGRAM_BOT_TOKEN=123456:your-bot-token

# Chat to send to (your user ID or a group ID). Default: empty.
# TELEGRAM_CHAT_ID=123456789

# ---------------------------------------------------------------------------
# Logging and paths
# ---------------------------------------------------------------------------

# debug, info, warn or error. debug also logs every prompt and model reply.
# Default: info.
# LOG_LEVEL=info

# Where guidance.md and rules.yaml are read from, and where state, caches and
# the audit log are written. Only change these when running outside Docker.
# Defaults: /config and /data.
# CONFIG_DIR=/config
# DATA_DIR=/data
